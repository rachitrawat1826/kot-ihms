<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us - IHMS Kotdwar</title>
    <link rel="stylesheet" href="/css/contact.css">

</head>

<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="nav-container">
            <div class="logo">
                <h3>IHMS Kotdwara</h3>
            </div>
            <ul class="nav-menu">
                <li><a href="/">Home</a></li>
                <li><a href="/">About</a></li>
                <li><a href="/course">Courses</a></li>
                <li><a href="/admission">Admission</a></li>
                <li><a href="/contact">Contact</a></li>
            </ul>
            <div class="nav-buttons">
                <a href="/login" class="btn-login">Login</a>
                <a href="/apply" class="btn-apply">Apply Now</a>
            </div>
        </div>
    </nav>

    <!-- Contact Hero -->
    <section class="contact-hero">
        <div class="container">
            <h1>Get In Touch</h1>
            <p>Have questions? We're here to help. Contact us today!</p>
        </div>
    </section>

    <!-- Contact Content -->
    <section class="contact-content">
        <div class="container">
            <div class="contact-grid">
                <!-- Contact Info -->
                <div class="contact-info">
                    <h3>Contact Information</h3>
                    <div class="info-item">
                        <div class="info-icon">📍</div>
                        <div>
                            <h4>Address</h4>
                            <p>I.H.M.S, Balbhadrapur<br>BEL Road, Kotdwar, Uttarakhand 246149</p>
                        </div>
                    </div>
                    <div class="info-item">
                        <div class="info-icon">📞</div>
                        <div>
                            <h4>Phone</h4>
                            <p>+91-7902000023<br>+91-8057726863</p>
                        </div>
                    </div>
                    <div class="info-item">
                        <div class="info-icon">✉️</div>
                        <div>
                            <h4>Email</h4>
                            <p>admissions@ihms.edu<br>info@ihms.ac.in</p>
                        </div>
                    </div>
                    <div class="info-item">
                        <div class="info-icon">🕒</div>
                        <div>
                            <h4>Hours</h4>
                            <p>Mon - Fri: 9AM - 5PM<br>Sat: 10AM - 2PM</p>
                        </div>
                    </div>
                </div>

                <!-- Contact Form -->
                <div class="contact-form-container">
                    <h3>Send us a Message</h3>
                    <form class="contact-form">
                        <div class="form-row">
                            <div class="input-group">
                                <input type="text" placeholder="Your Name" required>
                            </div>
                            <div class="input-group">
                                <input type="email" placeholder="Your Email" required>
                            </div>
                        </div>
                        <div class="input-group">
                            <input type="tel" placeholder="Phone Number">
                        </div>
                        <div class="input-group">
                            <textarea placeholder="Your Message" rows="5" required></textarea>
                        </div>
                        <button type="submit" class="btn-primary">Send Message</button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Quick Links Footer -->
    <footer class="quick-links">
        <div class="container">
            <h4>Quick Access</h4>
            <div class="links-grid">
                <a href="login.html" class="link-card">Student Login</a>
                <a href="admission.html" class="link-card">Admission Portal</a>
                <a href="apply.html" class="link-card">Apply Now</a>
            </div>
        </div>
    </footer>
</body>

</html>