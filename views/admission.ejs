<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admission Portal - IHMS KOTDWARA</title>
    <link rel="stylesheet" href="/css/admission.css">

    <style>
        .details-box {
            margin-top: 25px;
            padding: 20px;
            background: #f8f9fa;
            border-radius: 12px;
            text-align: left;
        }
        
        .details-box h3 {
            color: #2c5aa0;
            margin-bottom: 12px;
        }
        
        .details-box p {
            margin: 8px 0;
            color: #444;
            font-size: 15px;
        }
        
        .details-box ul {
            padding-left: 18px;
            color: #444;
        }
        
        .details-box li {
            margin: 8px 0;
        }
        
        body.dark-mode .details-box {
            background: #1f1f1f;
        }
        
        body.dark-mode .details-box p,
        body.dark-mode .details-box li {
            color: white;
        }
    </style>

</head>

<body>

    <div class="login-container">
        <div class="login-box">

            <h2>Admission Portal</h2>
            <p>Track your application status or apply now</p>

            <!-- Admission Details -->
            <div class="details-box">
                <h3>Admission Information</h3>

                <p><strong>Session:</strong> 2026 - 2027</p>
                <p><strong>Eligibility:</strong> 12th Pass / Graduation (Depends on Course)</p>
                <p><strong>Available Courses:</strong></p>

                <ul>
                    <li>BCA</li>
                    <li>BBA</li>
                    <li>BHM</li>
                    <li>MCA</li>
                    <li>MBA</li>
                    <li>B.Sc IT</li>
                </ul>

                <p><strong>Required Documents:</strong></p>

                <ul>
                    <li>10th Marksheet</li>
                    <li>12th Marksheet</li>
                    <li>Aadhar Card</li>
                    <li>Passport Size Photo</li>
                </ul>
            </div>

            <!-- Buttons -->
            <div class="admission-options">
                <a href="apply.html" class="btn-option">New Application</a>
                <a href="#" class="btn-option secondary">Check Status</a>
            </div>

            <div class="login-links">
                <a href="login.html">Student Login</a>
            </div>

        </div>
    </div>

</body>

</html>